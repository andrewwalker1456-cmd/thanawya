# Telegram Bot Token (REQUIRED)
BOT_TOKEN=your_bot_token_here

# Admin Telegram User IDs (comma-separated, REQUIRED for admin features)
ADMIN_IDS=123456789

# Path to SQLite database (converted from .accdb)
SOURCE_FILE=data/students.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Python unbuffered output
PYTHONUNBUFFERED=1

# Port for health check server (Render sets this automatically)
PORT=8080